# 联网剧本与钱包工具使用；离线测试不需要。API 只读取 RPC_URL，不读取 ANCHOR_WALLET。
RPC_URL=https://devnet.helius-rpc.com/?api-key=YOUR_HELIUS_API_KEY
ANCHOR_WALLET=/absolute/path/to/deployer-wallet.json

# 可选:Switchboard Crossbar 地址(默认 https://crossbar.switchboardlabs.xyz)
# CROSSBAR_URL=

# M7a：全部可选；勿把真实密钥文件或 .env 入库。
# FAUCET_URL=http://localhost:8788/faucet
# FAUCET_KEYPAIR=/absolute/path/to/faucet.keypair.json
# FAUCET_PORT=8788
# FAUCET_TUSDC_AMOUNT=1000
# FAUCET_TSOL_AMOUNT=10
# 默认每 5 小时最多 30 次全站领取(约 0.37 SOL / 5 小时，最坏约 1.8 SOL / 天)
# FAUCET_WINDOW_HOURS=5
# FAUCET_WINDOW_MAX=30
# FAUCET_MIN_SOL=0.2
# TRUST_PROXY_HOPS=0
# faucet-setup 每次补充的总量(UI 单位)
# FAUCET_SETUP_SOL=2
# FAUCET_SETUP_TUSDC=2000000
# FAUCET_SETUP_TSOL=20000

# 数据库里可能有多个池子(每次重跑剧本新建一个)。指定当前要展示和操作的 group;不设置则多池并存时 API 不猜。
# POOL_GROUP=GHVn8kr8ffkk6qynGKKbZ8PAgCM8xGFR9Gnhen3xig35

# 生产部署(主机上 docker-compose.prod.yml);私钥只用只读挂载文件,管理员钱包不部署到服务器。
# DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/postgres?sslmode=require
# RPC_URL=https://devnet.helius-rpc.com/?api-key=YOUR_HELIUS_API_KEY
# HOST=0.0.0.0
# PORT=8787
# FAUCET_PORT=8788
# ALLOWED_ORIGINS=https://your-app.vercel.app,https://preview.example
# FAUCET_URL=https://api.your-domain.example/faucet
# FAUCET_KEYPAIR_FILE=/absolute/path/to/faucet.json
# KEEPER_KEYPAIR_FILE=/absolute/path/to/keeper.json
# 容器内路径由 Compose 设置;不要把密钥数组直接写进环境变量。
# FAUCET_KEYPAIR=/run/secrets/faucet.json
# KEEPER_KEYPAIR=/run/secrets/keeper.json
# FAUCET_TUSDC_AMOUNT=1000
# FAUCET_TSOL_AMOUNT=10
# FAUCET_PSOL_AMOUNT=10
# FAUCET_PBTC_AMOUNT=0.006
# FAUCET_PETH_AMOUNT=0.2
# FAUCET_THYPE_AMOUNT=6
# FAUCET_WINDOW_HOURS=5
# FAUCET_WINDOW_MAX=30
# FAUCET_MIN_SOL=0.2
# TRUST_PROXY_HOPS=1
# SWAP_MIN_USD=0.05
# SWAP_MAX_USD=100
# POOL_GROUP=GHVn8kr8ffkk6qynGKKbZ8PAgCM8xGFR9Gnhen3xig35
